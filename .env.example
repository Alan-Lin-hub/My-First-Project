# Copy this file to .env and fill in real values.

# LLM — get a DeepSeek API key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Auth — REQUIRED for login. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
# Optional: access-token lifetime in minutes (default 720 = 12h)
# JWT_EXPIRE_MINUTES=720

# Initial admin account, seeded on first startup if no admin exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Production: restrict CORS to your real frontend origin(s), comma-separated
# CORS_ORIGINS=https://your-domain.example
