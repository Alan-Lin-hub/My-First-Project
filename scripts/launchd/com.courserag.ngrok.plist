<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.courserag.ngrok</string>

    <!-- 固定免费域名隧道，转发到本机 8000 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/linsen/.local/bin/ngrok</string>
        <string>http</string>
        <string>--url=https://engraving-exile-fester.ngrok-free.dev</string>
        <string>8000</string>
    </array>

    <!-- 清空代理变量：免费版 ngrok 不允许经 HTTP 代理（ERR_NGROK_9009）。
         launchd 会继承系统级 proxy（如 ClashX 设的全局代理），这里强制置空。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/linsen/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>http_proxy</key>
        <string></string>
        <key>https_proxy</key>
        <string></string>
        <key>HTTP_PROXY</key>
        <string></string>
        <key>HTTPS_PROXY</key>
        <string></string>
        <key>all_proxy</key>
        <string></string>
        <key>ALL_PROXY</key>
        <string></string>
    </dict>

    <!-- 手动启动，不再在开机/登录时自动拉起 -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/linsen/Library/Logs/courserag/ngrok.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/linsen/Library/Logs/courserag/ngrok.err.log</string>
</dict>
</plist>
